NODE_ENV=development
PORT=3000
MONGODB_URL=mongodb://127.0.0.1:27017/drivehub
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
ENCRYPTION_KEY=change-this-encryption-key-in-production
PLATFORM_COMMISSION=0.02

# Payments — platform wallet (no payment gateway).
# Admin credits user balance after offline payment (cash/bank transfer).
# Students pay enrollments from wallet balance inside the platform.

# ── Email (notifications + forgot-password OTP) ──────────────────────────────
# Kill-switch: only EMAIL_ENABLED=true sends via SMTP/Mailtrap.
# false / unset → skip outbound mail, log to console (OTP still works for forgot-password).
# Re-enable later: EMAIL_ENABLED=true
EMAIL_ENABLED=false
#
# No custom domain? Use one of the options below.
#
# Priority (notificationChannels.js):
#   0. EMAIL_ENABLED !== 'true'                      → console log only (no SMTP/Mailtrap)
#   1. SMTP_HOST                                     → nodemailer SMTP (Gmail or Sandbox SMTP)
#   2. MAILTRAP_USE_SANDBOX=true + token + inbox id  → Sandbox API (any recipient → Mailtrap inbox)
#   3. MAILTRAP_API_TOKEN only                       → Email Sending API (demo sender → account owner only)
#   4. none configured                               → console log (dev)
#
# ── Option A — Mailtrap Sandbox API (recommended for dev/testing) ───────────
# Captures emails for ANY recipient in your Mailtrap inbox — no domain needed.
# Get token: https://mailtrap.io/api-tokens
# Get inbox id from sandbox URL, e.g. https://mailtrap.io/inboxes/2564102 → 2564102
MAILTRAP_API_TOKEN=
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=
MAIL_FROM=sandbox@example.com
MAIL_FROM_NAME=DriveHub
#
# ── Option B — Mailtrap Sandbox SMTP (alternative to Option A) ──────────────
# Leave MAILTRAP_USE_SANDBOX=false (or empty token) and use SMTP credentials from:
# Mailtrap → Email Testing → Inboxes → SMTP Settings
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=<from Mailtrap SMTP settings>
# SMTP_PASS=<from Mailtrap SMTP settings>
#
# ── Option C — Gmail SMTP (real delivery, no custom domain) ───────────────
# 1. Sign in to the Gmail account you will send from (not a different Google account).
# 2. Enable 2-Step Verification: https://myaccount.google.com/security
# 3. Create an App Password: https://myaccount.google.com/apppasswords
#    - App: Mail, Device: Other ("DriveHub Backend")
#    - Paste the 16-character password WITHOUT spaces into SMTP_PASS
# 4. Leave MAILTRAP_API_TOKEN empty; set SMTP vars only:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=abcdefghijklmnop
# SMTP_FROM="DriveHub <your@gmail.com>"
# If 535 BadCredentials persists: regenerate the app password, check
# https://myaccount.google.com/notifications for security blocks, then restart the server.
# Test: node scripts/smtp-test.js (from backend/)
#
# ── Option D — Mailtrap Email Sending (production, needs verified domain) ───
# MAILTRAP_API_TOKEN=<sending token>
# MAILTRAP_USE_SANDBOX=false
# MAIL_FROM=hello@your-verified-domain.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Password reset (forgot password)
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# Admin seed (npm run seed:admin)
ADMIN_USERNAME=Admin
ADMIN_EMAIL=admin@drivehub.local
ADMIN_PASSWORD=AdminPass1!
ADMIN_PHONE=+963000000000
